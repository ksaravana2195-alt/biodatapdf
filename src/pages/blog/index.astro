---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<SiteLayout title="Marriage Biodata Guides & Tips | BiodataPDF" description="Guides on how to write a marriage biodata: format, what to include, photo tips and partner expectations.">
	<main class="sec"><div class="wrap">
		<h1>Marriage biodata guides</h1>
		<div class="cards">
			{posts.map((p) => <a class="cc" href={`/blog/${p.id}/`}><b>{p.data.title}</b><span>{p.data.description}</span></a>)}
		</div>
	</div></main>
</SiteLayout>
